* text=auto eol=lf
*.png binary

# Git LFS (docs/ASSET_BUDGET.md): heavy binary assets live outside the git
# history. Clone with git-lfs installed (README, «Клонирование»).
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.ogv filter=lfs diff=lfs merge=lfs -text
# Large PNGs: backgrounds and big atlases. Small sprites and icons stay in
# git (diffable, no LFS round trip); size_report.py --check fails on a PNG
# over 1 MB that no LFS rule covers.
assets/sprites/backgrounds/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*_atlas.png filter=lfs diff=lfs merge=lfs -text
assets/**/*_large.png filter=lfs diff=lfs merge=lfs -text
