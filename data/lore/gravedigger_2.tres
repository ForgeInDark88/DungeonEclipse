[ext_resource type="Script" path="res://scripts/data/lore_data.gd" id="1_lore"]

[resource]
script = ExtResource("1_lore")
id = &"gravedigger_2"
title = "Дневник могильщика, страница вторая"
author = "Олдрик, могильщик"
text = "Король велел хоронить всех в старых катакомбах, поглубже. Сказал: мёртвым всё равно. Мёртвым — может быть. Но кости сами складываются в ряды, когда я ухожу, и черепа смотрят в одну сторону. Вниз. Туда, где тёплое."
biome = &"catacombs"
boss = &""
order = 1
