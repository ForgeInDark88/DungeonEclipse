[gd_resource type="Resource" script_class="LoreData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/lore_data.gd" id="1_lore"]

[resource]
script = ExtResource("1_lore")
id = &"chronicle_3"
title = "Хроника Аурелии, последняя запись"
author = "Летописец двора"
text = "Печать держится, но город пустеет: кто мог — ушёл на поверхность, к краю ущелья, где основали деревню у входа. Храм обвалился внутрь, в провал. Я остаюсь со свитками. Кто-то должен помнить, что под руинами не камни — под ними клятва."
biome = &"ruins"
boss = &""
order = 8
