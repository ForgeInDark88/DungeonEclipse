[gd_resource type="Resource" script_class="LoreData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/lore_data.gd" id="1_lore"]

[resource]
script = ExtResource("1_lore")
id = &"decree_1"
title = "Королевский указ, обугленный"
author = "Король Аурелии"
text = "Повелеваю: да будет сожжено всё, что даёт свет, — свечи, масло, леса, амбары. Тьма питается светом, что падает вниз. Не будет света — не будет пищи. Пусть мой народ мёрзнет сегодня, чтобы жить завтра."
biome = &"ashen_halls"
boss = &""
order = 15
