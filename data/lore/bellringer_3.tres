[ext_resource type="Script" path="res://scripts/data/lore_data.gd" id="1_lore"]

[resource]
script = ExtResource("1_lore")
id = &"bellringer_3"
title = "Записка в бутылке"
author = "?"
text = "Звонарь утонул, а колокол звонит. Сам. Глухо, под водой, раз в час. Иногда — когда кто-то спускается слишком глубоко. Если услышишь звон за спиной, не оборачивайся: это он считает живых."
biome = &"drowned_vaults"
boss = &""
order = 23
