[gd_resource type="Resource" script_class="LoreData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/lore_data.gd" id="1_lore"]

[resource]
script = ExtResource("1_lore")
id = &"smith_2"
title = "Письмо кузнеца Торна, второе"
author = "Торн, кузнец"
text = "Чародейка приходила в кузню. Огненные волосы, глаза как угли. Сказала, что если разжечь здесь огонь достаточно сильный — получится новое солнце, и оно вытолкнет чёрное прочь. Она просит лаву. Много лавы. Мы роем каналы день и ночь."
biome = &"lava"
boss = &""
order = 10
