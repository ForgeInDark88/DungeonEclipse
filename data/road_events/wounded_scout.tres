[gd_resource type="Resource" script_class="EventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/event_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"wounded_scout"
title = "Раненый разведчик"
text = "У стены сидит разведчик гильдии. Нога перетянута ремнём, на коленях — исчерканная карта. «Воды... или хоть зелья», — шепчет он."
regions = Array[StringName]([])
min_depth = 1
max_depth = 99
weight = 1.0
prop = &"scout"
options = Array[Dictionary]([{"text": "Отдать зелье здоровья.", "requires": "item:health_potion", "hint": "нужно зелье здоровья", "outcomes": [{"chance": 1.0, "text": "Разведчик оживает и в благодарность отмечает на вашей карте все знаки: теперь вы читаете дорогу, как он.", "effects": {"take_item": "health_potion", "rumours": true, "xp": 15}}]}, {"text": "Обыскать его сумку, пока он слаб.", "requires": "", "hint": "", "outcomes": [{"chance": 0.7, "text": "В сумке золото и пара полезных мелочей. Разведчик смотрит вам вслед — молча.", "effects": {"gold": 60, "loot": "chest_common"}}, {"chance": 0.3, "text": "Он оказался не так уж слаб: удар кинжалом, и он ковыляет прочь. Удача отвернулась от вас.", "effects": {"hp_pct": -15, "pact": "curse"}}]}, {"text": "Пройти мимо.", "requires": "", "hint": "", "outcomes": [{"chance": 1.0, "text": "Вы идёте дальше, ничего не потеряв и ничего не найдя.", "effects": {}}]}])
