[gd_resource type="Resource" script_class="EventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/event_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"crystal_vein"
title = "Кристальная жила"
text = "Лунный кристалл светится в трещине. Если ударить неосторожно, свод может не выдержать."
regions = Array[StringName]([&"deeps"])
min_depth = 16
max_depth = 30
weight = 1.0
options = Array[Dictionary]([{"text": "Добыть кристалл.", "requires": "", "hint": "", "outcomes": [{"chance": 0.7, "text": "Кристалл поддаётся.", "effects": {"resource": {"crystal": 2}}}, {"chance": 0.3, "text": "Свод трещит и осыпается. Кристалл вы спасли, а плечи — нет.", "effects": {"resource": {"crystal": 1}, "hp_pct": -25}}]}, {"text": "Работать, как учил Ульф.", "requires": "resident:mason", "hint": "каменщик Ульф в городе", "outcomes": [{"chance": 1.0, "text": "Клинья, распорки, точный удар — и три кристалла без единой трещины.", "effects": {"resource": {"crystal": 3, "stone": 2}}}]}, {"text": "Пройти мимо.", "requires": "", "hint": "", "outcomes": [{"chance": 1.0, "text": "Вы идёте дальше, ничего не потеряв и ничего не найдя.", "effects": {}}]}])
