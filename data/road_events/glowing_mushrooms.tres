[gd_resource type="Resource" script_class="EventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/event_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"glowing_mushrooms"
title = "Светящиеся грибы"
text = "Поляна голубых грибов. Они светятся тем же светом, что и чёрное солнце внизу, и пахнут мёдом."
regions = Array[StringName]([&"gates"])
min_depth = 1
max_depth = 12
weight = 1.0
options = Array[Dictionary]([{"text": "Съесть парочку.", "requires": "", "hint": "", "outcomes": [{"chance": 0.5, "text": "Тепло разливается по телу: раны затягиваются, мысли ясные.", "effects": {"heal_full": true, "pact": "blessing"}}, {"chance": 0.5, "text": "Голова кружится, к горлу подступает тошнота. Зря.", "effects": {"hp_pct": -20, "pact": "c_fog"}}]}, {"text": "Собрать, как учила Мира.", "requires": "resident:healer", "hint": "травница Мира в городе", "outcomes": [{"chance": 1.0, "text": "Мира показывала, какие брать. Сумка полна целебных трав.", "effects": {"resource": {"herbs": 5}, "hp_pct": 20}}]}, {"text": "Собрать немного на травы.", "requires": "", "hint": "", "outcomes": [{"chance": 1.0, "text": "Вы срезаете шляпки, не дыша.", "effects": {"resource": {"herbs": 2}}}]}])
