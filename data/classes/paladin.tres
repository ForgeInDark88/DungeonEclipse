skills = Array[ExtResource("3_skill")]([ExtResource("4_holy"), ExtResource("5_strike"), ExtResource("6_skin"), ExtResource("7_shield"), ExtResource("sk_blessing"), ExtResource("sk_holy_strike"), ExtResource("sk_light_aura"), ExtResource("sk_righteous_wrath")])
