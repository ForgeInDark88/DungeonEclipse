[gd_resource type="Resource" script_class="NpcData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/npc_data.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/sprites/npc/alchemist.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/sprites/portraits/npc_alchemist.png" id="3"]

[resource]
script = ExtResource("1")
id = &"alchemist"
display_name = "Квинт"
profession = "Алхимик"
order = 4
resident_from_start = false
home = &"alchemist"
sprite = ExtResource("2")
portrait = ExtResource("3")
discount = 0.0
build_discount = 0.0
depth_min = 4
rescue_text = "Осторожнее с этими колбами! Ах, это вы меня освободили... Квинт, алхимик. Мне нужна лаборатория и травы — много трав."
dialogs = Array[Dictionary]([{"id": "intro", "when": "", "once": true, "text": "Свет Затмения меняет травы: они растут быстрее и лечат сильнее. Опасно? Безусловно. Полезно? Чрезвычайно.", "options": [{"text": "Сваришь мне зелий?", "reply": "Постройте лабораторию — и я обеспечу вас зельями на любой поход."}]}, {"id": "idle", "when": "", "once": false, "text": "Не нюхайте синюю колбу. Просто не нюхайте.", "options": []}])
