[gd_resource type="Resource" script_class="NpcData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/npc_data.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/sprites/npc/innkeeper.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/sprites/portraits/npc_innkeeper.png" id="3"]

[resource]
script = ExtResource("1")
id = &"innkeeper"
display_name = "Хельга"
profession = "Хозяйка таверны"
order = 3
resident_from_start = false
home = &"tavern"
sprite = ExtResource("2")
portrait = ExtResource("3")
discount = 0.05
build_discount = 0.0
depth_min = 1
rescue_text = "Ох, свобода! Я Хельга. Была у меня таверна — была, пока не пришли эти твари. Отстрой её, и у тебя будет лучшая похлёбка и самые свежие слухи."
dialogs = Array[Dictionary]([{"id": "intro", "when": "", "once": true, "text": "Путники болтают, а я слушаю. Кто где видел клетку, где блестело золото, где лучше не ходить — всё через мою стойку.", "options": [{"text": "Расскажешь мне?", "reply": "За кружку и пару монет — конечно. Заходи в таверну перед походом."}]}, {"id": "idle", "when": "", "once": false, "text": "Пиво сегодня тёмное, как Затмение. Шучу. Почти.", "options": []}])
