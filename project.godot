; Engine configuration file.
config_version=5

[application]

config/name="DungeonEclipse"
config/description="2D roguelike platformer in a dark fantasy dungeon."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/sprites/items/eclipse_ring.png"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
ItemDatabase="*res://scripts/autoload/item_database.gd"
GameState="*res://scripts/autoload/game_state.gd"
Tooltip="*res://scripts/autoload/tooltip_layer.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/theme.tres"

